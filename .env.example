# Supabase (required for auth + database clients)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# OpenRouteService — route geometry + deviation penalties (Phase 2)
# Get a key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Escrow HMAC secret for QR handshake tokens (Phase 3) — min 16 chars
ESCROW_HMAC_SECRET=change_me_to_a_long_random_secret

# Server-only (Phase 4+ escrow / admin); do not expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
